# CONFIGURACIÓN DE SAC WEB - EJEMPLO
# Copia este archivo como .env y ajusta los valores

# SEGURIDAD
# Genera una clave segura (ej: python -c 'import secrets; print(secrets.token_urlsafe(50))')
SECRET_KEY=cambiame-por-una-clave-secreta-y-segura-de-al-menos-50-caracteres

# MODO DEPURACIÓN (True para desarrollo, False para producción)
DEBUG=True

# HOSTS PERMITIDOS (Separados por comas)
# Ej: localhost,127.0.0.1,mi-dominio.com
ALLOWED_HOSTS=localhost,127.0.0.1

# BASE DE DATOS (Opcional, por defecto usa SQLite)
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3
